# Copy this file to ".env" (same folder) and fill in real values.
# The real .env file is git-ignored - NEVER commit it.

NODE_ENV=development

# API server address. 127.0.0.1 = reachable only from this computer.
HOST=127.0.0.1
PORT=4000

# The only browser origin allowed to call the API (the React dev server).
CORS_ORIGIN=http://localhost:5173

# SQLite database file, relative to the backend/ folder.
DB_STORAGE=./data/database.sqlite

# Secret key for HMAC-SHA256 password hashing (the "pepper").
# Must be at least 32 characters. Generate a strong one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: changing this value invalidates every stored password.
HMAC_SECRET=
